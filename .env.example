# Copy to .env (gitignored) and fill in. cloud.py reads .env automatically; real environment variables win.

# RunPod -> Settings -> API Keys
RUNPOD_API_KEY=

# A fine-grained Hugging Face token (huggingface.co/settings/tokens) with read access to the dataset repo
# (e.g. edededdy/littlekedi-data-mix-8k-4b) and write access to the runs repo (edededdy/littlekedi-runs).
# It is stored in the pod's environment on RunPod, so don't use your main token.
LK_HF_TOKEN=
